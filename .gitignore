# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

# Build directory
build*/

# Acquired data (kept out of git)
data/
*.h5
*.h5.gz

# Analysis outputs (rigenerabili dai notebook)
*.csv

# Jupyter checkpoints
.ipynb_checkpoints/

# macOS
.DS_Store

# Config di run locali alla macchina: si modificano liberamente durante i test
# senza far divergere il template versionato (config/template-daq.toml)
config/*-local.toml
config/run-*.toml
# Indirizzi degli alimentatori del PC DAQ, letti da start_DAQ-controller.sh
config/*-local.env

# Editor / manual backup files
*~
*_org
*_ok
*_save
*.weird
*.bak
# I backup datati che si fanno da soli: il controllore ne scrive uno a ogni
# modifica del TOML dalla pagina, e ne sono gia' 205. Non e' pignoleria di
# ordine: con duecento righe di rumore in "git status" le modifiche VERE non
# si vedono, ed e' cosi' che le misure del 14 ottobre sono rimaste non
# committate su una macchina che non puo' fare push.
*.bak-*
*.bak[0-9]*
*-dev

# Grafici generati da tools/plot_waveforms.py
plots/
*.png

# Bytecode di Python: lo produce ogni esecuzione sul PC DAQ e sporcava
# "git status" li, facendo sembrare divergente una copia allineata.
__pycache__/
*.pyc

# Ambiente per il foglio e-log: librerie, non codice del progetto
.venv-elog/
